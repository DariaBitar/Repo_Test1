#Problem 4 
#Here we have to create a class Vector that represents a vector in space, with x, y, and z as its attributes. 
class Vector:
    def __init__(self, x: float, y: float, z: float):
        self.x = x
        self.y = y
        self.z = z

    def __mul__(self, other: "Vector") -> float:
        return (self.x * other.x) + (self.y * other.y) + (self.z * other.z)

#Problem 5 
#Overload all comparison operators (<, >, ==, !=, >=, <=) for a Circle class based on radius.
class Circle:
    def __init__(self, radius: float):
        self.radius = radius

    def __lt__(self, other: "Circle") -> bool:
        return self.radius < other.radius

    def __gt__(self, other: "Circle") -> bool:
        return self.radius > other.radius

    def __eq__(self, other: object) -> bool:
        if not isinstance(other, Circle):
            return False
        return self.radius == other.radius

    def __ne__(self, other: object) -> bool:
        return not self.__eq__(other)

    def __le__(self, other: "Circle") -> bool:
        return self.radius <= other.radius

    def __ge__(self, other: "Circle") -> bool:
        return self.radius >= other.radius

#Problem 6 
# Implement a 2D point class.
class Point2D:
    def __init__(self, x: float, y: float):
        self.x = x
        self.y = y

    def distance(self) -> float:
        return math.sqrt(self.x**2 + self.y**2)

    def __lt__(self, other: "Point2D") -> bool:
        return self.distance() < other.distance()

    def __gt__(self, other: "Point2D") -> bool:
        return self.distance() > other.distance()

    def __eq__(self, other: object) -> bool:
        if not isinstance(other, Point2D):
            return False
        return math.isclose(self.distance(), other.distance())

    def __ne__(self, other: object) -> bool:
        return not self.__eq__(other)

    def __le__(self, other: "Point2D") -> bool:
        return self.distance() <= other.distance()

    def __ge__(self, other: "Point2D") -> bool:
        return self.distance() >= other.distance()

#Problem 7 
#Overload the multiplication operator for two matrices
class Matrix:
    def __init__(self, grid: list[list[float]]):
        self.grid = grid
        self.rows = len(grid)
        self.cols = len(grid[0]) if grid else 0

    def __mul__(self, other: "Matrix") -> "Matrix":
        if self.cols != other.rows:
            raise ValueError("Matrix A columns must equal Matrix B rows")
        result = [
            [
                sum(self.grid[i][k] * other.grid[k][j] for k in range(self.cols))
                for j in range(other.cols)
            ]
            for i in range(self.rows)
        ]
        return Matrix(result)

