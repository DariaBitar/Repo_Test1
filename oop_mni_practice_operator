# Problem 1 
# We have to implement a complex number class. Overload the addition and subtraction operators to add and subtract two complex numbers.
# To do that we have to use the dunder method seen in class for example + becomes __add__, - = __sub__ etc..
import math
class ComplexNumber:
    def __init__(self, real: float, imag: float):
        self.real = real
        self.imag = imag

    def __add__(self, other: "ComplexNumber") -> "ComplexNumber":
        return ComplexNumber(self.real + other.real, self.imag + other.imag)

    def __sub__(self, other: "ComplexNumber") -> "ComplexNumber":
        return ComplexNumber(self.real - other.real, self.imag - other.imag)

    def __str__(self) -> str:
        return f"{self.real} + {self.imag}i"

