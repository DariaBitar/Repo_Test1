classDiagram
    class User {
        -id: str
        -name: str
        -password: str
        +login() bool
        +logout() void
    }

    class Patient {
        -medicalHistory: str
        +postProblem(description: str) HealthProblem
        +pay(problem: HealthProblem, method: Payment) bool
        +viewPastPrescriptions() list~Prescription~
    }

    class Organizer {
        -adminLevel: str
        +assignDoctor(problem: HealthProblem, doctor: Doctor) void
        +issueCredentials(user: User) void
        +forwardPayment(payment: Payment, doctor: Doctor) void
        +updateSystem() void
    }

    class Doctor {
        -specialty: str
        +diagnose(problem: HealthProblem) void
        +writePrescription(problem: HealthProblem, details: str) Prescription
    }

    class ProblemStatus {
        <<enumeration>>
        PENDING
        IN_REVIEW
        RESOLVED
    }

    class HealthProblem {
        -id: str
        -description: str
        -status: ProblemStatus
        -createdAt: datetime
        +updateStatus(status: ProblemStatus) void
    }

    class Prescription {
        -id: str
        -details: str
        -createdAt: datetime
        -isReusable: bool
    }

    class Payment {
        <<abstract>>
        -amount: float
        -timestamp: datetime
        +processPayment()* bool
    }

    class CashPayment {
        +processPayment() bool
    }

    class CheckPayment {
        -checkNumber: str
        +processPayment() bool
    }

    class CreditCardPayment {
        -cardLast4: str
        +processPayment() bool
    }

    User <|-- Patient
    User <|-- Organizer
    User <|-- Doctor

    Patient "1" *-- "0..*" HealthProblem : submits
    Organizer "1" -- "0..*" HealthProblem : reviews
    Doctor "1" -- "0..*" Prescription : issues
    HealthProblem "1" -- "0..1" Prescription : produces
    HealthProblem "1" -- "1" Payment : settles
    HealthProblem ..> ProblemStatus : uses

    Payment <|-- CashPayment
    Payment <|-- CheckPayment
    Payment <|-- CreditCardPayment

