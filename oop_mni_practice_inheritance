# Problem 1 
# Create a class Vehicle that has a method drive that returns the string "Driving a vehicle".
class Vehicle:
    def drive(self) -> str:
        return "Driving a vehicle"


class Car(Vehicle):
    def drive(self) -> str:
        return "Driving a car"


class Bicycle(Vehicle):
    def drive(self) -> str:
        return "Riding a bicycle"

# Problem 2 
# We first have to create  a class for a Person with attributes like name,age etc. and the method : introduce 
# Then we create a subclass of person that is student with field_of_study like attribute
# and third the second subclass being employee of Person wit attribute company and personalize introduce 

class Person:
    def __init__(self, name: str, age: int, address: str):
        self.name = name
        self.age = age
        self.address = address

    def introduce(self) -> str:
        return f"Hello, my name is {self.name}, I am {self.age} and I live at {self.address}."


class Student(Person):
    def __init__(self, name: str, age: int, address: str, field_of_study: str):
        super().__init__(name, age, address)
        self.field_of_study = field_of_study

    def introduce(self) -> str:
        return f"{super().introduce()} I study {self.field_of_study}."


class Employee(Person):
    def __init__(self, name: str, age: int, address: str, company: str):
        super().__init__(name, age, address)
        self.company = company

    def introduce(self) -> str:
        return f"{super().introduce()} I work at {self.company}."

# Final problem : Problem 3 
# Two classes this time bank account and Saving accounts
class BankAccount:
    def __init__(self, account_number: str, balance: float = 0.0):
        self.account_number = account_number
        self.balance = balance

    def deposit(self, amount: float) -> None:
        if amount > 0:
            self.balance += amount

    def withdraw(self, amount: float) -> bool:
        if 0 < amount <= self.balance:
            self.balance -= amount
            return True
        return False

    def transfer(self, amount: float, destination_account: "BankAccount") -> bool:
        if self.withdraw(amount):
            destination_account.deposit(amount)
            return True
        return False


class SavingsAccount(BankAccount):
    def __init__(self, account_number: str, balance: float = 0.0, interest_rate: float = 0.03):
        super().__init__(account_number, balance)
        self.interest_rate = interest_rate

    def add_interest(self) -> None:
        self.balance += self.balance * self.interest_rate

    def check_balance(self) -> float:
        return self.balance


